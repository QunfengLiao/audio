# Required: Alibaba Cloud Model Studio API key for China (Beijing).
DASHSCOPE_API_KEY=sk-your-api-key

# Recommended: your Model Studio workspace ID. When omitted, the legacy
# Beijing WebSocket endpoint is used; Alibaba Cloud currently keeps it active.
DASHSCOPE_WORKSPACE_ID=

# Optional override, mainly useful for proxies and local protocol testing.
# DASHSCOPE_WS_URL=wss://your-workspace-id.cn-beijing.maas.aliyuncs.com/api-ws/v1/realtime

# Optional model override.
# DASHSCOPE_ASR_MODEL=qwen3-asr-flash-realtime
